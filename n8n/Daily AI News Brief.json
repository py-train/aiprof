      "parameters": {
        "jsCode": "// Collect story IDs from the previous HTTP node\nconst storyIds = $input.all().map(item => item.json);\nconst idList   = storyIds.slice(0, 5).join(\", \");\n\n// Compose the prompt we will send to OpenAI\nconst prompt = `You are a helpful technology analyst writing for business professionals.\n\nThe top 5 trending story IDs on Hacker News right now are: ${idList}.\n\nHacker News is a technology and startup news aggregator widely read by developers,\nfounders, and business leaders. Based on the context that these are currently\nthe most upvoted stories, please:\n\n1. Write a 3-sentence summary of what types of topics are likely trending\n   in the global technology community today.\n2. Suggest 2 strategic questions a senior business professional at a consulting\n   firm might want to explore based on today's technology trends.\n3. Rate the overall market sentiment (Bullish / Neutral / Cautious) and explain why in one sentence.\n\nKeep your response professional, concise, and insightful.`;\n\n// Return structured output for the next node\nreturn [{\n  json: {\n    prompt      : prompt,\n    story_ids   : storyIds.slice(0, 5),\n    generated_at: new Date().toISOString()\n  }\n}];\n\n// return [{\n//   json: prompt\n// }];\n"
      },
