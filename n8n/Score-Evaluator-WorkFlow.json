      "position": [
        -256,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Access the data that came in via the webhook body\nconst score = $input.first().json.body.score;\nconst name  = $input.first().json.body.name || 'Candidate';\n\n// Assign letter grade\nconst grade = score >= 90 ? 'A' : score >= 80 ? 'B' : 'C';\n\nconst result = {\n  status   : 'PASS',\n  name     : name,\n  score    : score,\n  grade    : grade,\n  message  : `Congratulations ${name}! You scored ${score}/100. Result: PASS.`,\n  timestamp: new Date().toISOString()\n};\n\n// n8n Code nodes must return an array of items\nreturn [{ json: result }];"
      },
      "id": "d7715c35-4950-4c4e-a03f-676adad5cc9f",
      "name": "Pass Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -32,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Access the data that came in via the webhook body\nconst score = $input.first().json.body.score;\nconst name  = $input.first().json.body.name || 'Candidate';\n\n// How many marks short of passing?\nconst gap = 70 - score;\n\nconst result = {\n  status   : 'FAIL',\n  name     : name,\n  score    : score,\n  grade    : 'F',\n  message  : `Sorry ${name}, you scored ${score}/100. You need ${gap} more marks to pass.`,\n  timestamp: new Date().toISOString()\n};\n\nreturn [{ json: result }];"
      },
